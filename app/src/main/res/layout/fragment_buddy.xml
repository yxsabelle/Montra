<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Montra.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="14dp"
                android:text="←" />

            <TextView
                style="@style/Montra.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget Buddy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_red"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="BB"
                android:textColor="@color/cream"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdvice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bubble"
                android:padding="16dp"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Montra.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/Montra.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget Progress"
                android:textSize="18sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/buddyProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:indicatorColor="@color/red"
                app:trackColor="@color/beige_dark"
                app:trackCornerRadius="8dp"
                app:trackThickness="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBuddySpent"
                    style="@style/Montra.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvBuddyPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Montra.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Montra.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spending Reminders"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvReminder"
                style="@style/Montra.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Enable reminders"
                android:textColor="@color/text_dark" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>