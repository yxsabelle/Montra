<resources <style name="Theme.Montra.App" parent="Theme.Material3.Light.NoActionBar">
<item name="colorPrimary">@color/red</item>
<item name="colorOnPrimary">@color/cream</item>
<item name="colorSurface">@color/cream</item>
<item name="colorOnSurface">@color/text_dark</item>
<item name="android:statusBarColor">@color/cream</item>
<item name="android:navigationBarColor">@color/cream</item>
<item name="android:windowLightStatusBar">true</item>
<item name="android:windowBackground">@color/cream</item>
</style>

<style name="Montra.Heading">
<item name="android:textColor">@color/text_dark</item>
<item name="android:textSize">22sp</item>
<item name="android:textStyle">bold</item>
<item name="android:fontFamily">serif</item>
</style>

<style name="Montra.Body">
<item name="android:textColor">@color/text_gray</item>
<item name="android:textSize">13sp</item>
</style>

<style name="Montra.Label">
<item name="android:textColor">@color/text_dark</item>
<item name="android:textSize">14sp</item>
<item name="android:textStyle">bold</item>
</style>

<style name="Montra.Input">
<item name="android:background">@drawable/bg_input</item>
<item name="android:textColor">@color/text_dark</item>
<item name="android:textColorHint">@color/text_gray</item>
<item name="android:textSize">14sp</item>
<item name="android:paddingStart">14dp</item>
<item name="android:paddingEnd">14dp</item>
</style>

<style name="Montra.Button">
<item name="android:background">@drawable/bg_button</item>
<item name="android:textColor">@color/cream</item>
<item name="android:textAllCaps">false</item>
<item name="android:textStyle">bold</item>
<item name="android:textSize">16sp</item>
</style>

<style name="Montra.ButtonOutline">
<item name="android:background">@drawable/bg_button_outline</item>
<item name="android:textColor">@color/red</item>
<item name="android:textAllCaps">false</item>
<item name="android:textStyle">bold</item>
<item name="android:textSize">14sp</item>
</style>

<style name="Montra.Card">
<item name="android:background">@drawable/bg_panel</item>
<item name="android:padding">16dp</item>
</style>
</resources>